{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-dev",
      "!**/out",
      "!**/dist",
      "!**/coverage",
      "!packages/techradar/data/*.json",
      "!packages/techradar/src/components/Icons",
      "!packages/techradar/public/og",
      "!packages/create-techradar/dist"
    ]
  },

  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },

  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": { "useUniqueElementIds": "off" },
      "performance": { "noImgElement": "off" },
      "security": { "noBlankTarget": "off" },
      "style": {
        "useComponentExportOnlyModules": "off",
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": false }
        }
      }
    },
    "domains": {
      "next": "all",
      "react": "all"
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },

  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },

  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },

  "overrides": [
    {
      "includes": [
        "commitlint.config.js",
        "packages/techradar/postcss.config.js",
        "packages/techradar/next.config.js",
        "packages/*/bin/**"
      ],
      "javascript": {
        "globals": ["module", "require", "process", "__dirname"]
      },
      "linter": {
        "rules": {
          "style": { "noCommonJs": "off" }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      // Biome 2.5.6 started applying this JSX rule to standalone .svg assets.
      // These are served as images or compiled into Icon components, so their
      // accessible name comes from the consuming element, not an inline
      // <title>. The rule stays on for SVG written inline in JSX.
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": { "noSvgWithoutTitle": "off" }
        }
      }
    }
  ]
}
