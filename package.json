{
  "name": "porschedigital-technology-radar-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "check:arch": "pnpm -r --if-present run check:arch",
    "check:sec": "pnpm -r --if-present run check:sec && pnpm run check:sec:deps && pnpm run check:sec:secrets && pnpm run check:sec:licenses",
    "check:sec:deps": "osv-scanner --lockfile=pnpm-lock.yaml",
    "check:sec:secrets": "pnpm --filter @porscheofficial/porschedigital-technology-radar run check:sec:secrets",
    "check:sec:licenses": "pnpm run check:sec:licenses:techradar && pnpm run check:sec:licenses:scaffolder",
    "check:sec:licenses:techradar": "license-checker-rseidelsohn --start packages/techradar --production --failOn 'GPL;AGPL;LGPL;SSPL;BUSL;CC-BY-NC'",
    "check:sec:licenses:scaffolder": "license-checker-rseidelsohn --start packages/create-techradar --production --failOn 'GPL;AGPL;LGPL;SSPL;BUSL;CC-BY-NC'",
    "check:quality": "pnpm -r --if-present run check:quality",
    "check:a11y": "pnpm -r --if-present run check:a11y",
    "check:build": "pnpm -r --if-present run check:build",
    "precommit:secrets": "pnpm --filter @porscheofficial/porschedigital-technology-radar run precommit:secrets",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.3.0"
  },
  "lint-staged": {
    "**/*": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "satori>fflate": "0.7.5",
      "micromark-extension-math>katex": "0.18.2",
      "minimatch@10.2.6": "11.0.8",
      "glob@13": "14.0.6",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "fast-uri@3": "^3.1.9",
      "ip-address@10": "^10.7.4",
      "js-yaml@4": "^4.3.2",
      "js-yaml@5": "^5.4.1",
      "postcss-selector-parser@7": "^7.1.6",
      "smol-toml@1": "^1.9.0",
      "source-map-js@1": "^1.2.2",
      "undici@6": "^6.29.1",
      "undici@8": "^8.12.2",
      "vite@8.2.0": "8.2.4"
    }
  }
}
